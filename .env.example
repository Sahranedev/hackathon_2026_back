# Copy this file to `.env` and adjust the values if needed.

# PostgreSQL (Docker) credentials — used by docker-compose.yml
POSTGRES_USER="hackasaumon"
POSTGRES_PASSWORD="hackasaumon"
POSTGRES_DB="hackasaumon"
POSTGRES_PORT="5433"

# Connection string used by Prisma. Must match the credentials above.
DATABASE_URL="postgresql://hackasaumon:hackasaumon@localhost:5433/hackasaumon?schema=public"

# JWT
JWT_SECRET="change_me"
JWT_EXPIRES_IN="1d"
