// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  mail          String         @unique()
  password      String?
  stravaAccount StravaAccount?
  oauthStates   OAuthState[]
  tires         UserTire[]
  roles         Roles[]        @default([USER])
  activities    Activity[]

  @@map("Users")
}

model StravaAccount {
  id String @id @default(uuid())

  userId    Int @unique
  athleteId Int @unique

  username  String?
  firstname String?
  lastname  String?
  profile   String?

  accessToken  String
  refreshToken String
  expiresAt    Int

  scope String?

  lastSyncAt DateTime? @map("last_sync_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model OAuthState {
  id String @id @default(uuid())

  provider String
  userId   Int

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserTire {
  id            Int            @id @default(autoincrement())
  position      String?
  tireId        Int?           @map("tire_id")
  userId        Int?           @map("user_id")
  deviceId      String?        @unique @map("device_id")
  kilometers    Int?
  smartTire     Boolean?       @map("smart_tire")
  isActive      Boolean?       @map("isActive")
  tire          TireData?      @relation(fields: [tireId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  activityTires ActivityTire[]
  alerts        Alert[]

  @@map("users_tire")
}

model Activity {
  id               Int                @id @default(autoincrement())
  userId           Int                @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stravaActivityId BigInt?            @map("strava_activity_id")
  name             String?
  source           ActivitySource
  status           ActivityStatus     @default(COMPLETED)
  startPosition    Int?               @map("start_position")
  kilometers       Float?
  durationSeconds  Int?               @map("duration_seconds")
  terrainType      TerrainType        @default(UNKNOWN) @map("terrain_type")
  startedAt        DateTime?          @map("started_at")
  endedAt          DateTime?          @map("ended_at")
  date             DateTime?          @db.Date
  tires            ActivityTire[]
  gpsPoints        ActivityGpsPoint[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, stravaActivityId])
  @@index([userId])
  @@map("Activities")
}

model ActivityGpsPoint {
  id Int @id @default(autoincrement())

  activityId Int @map("activity_id")

  latitude   Float
  longitude  Float
  accuracy   Float?
  altitude   Float?
  speed      Float?
  recordedAt DateTime @map("recorded_at")

  createdAt DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("ActivityGpsPoints")
}

model Alert {
  id         Int     @id @default(autoincrement())
  userTireId Int     @map("user_tire_id")
  code       String
  isChecked  Boolean @default(false)
  message    String

  userTire UserTire? @relation(fields: [userTireId], references: [id])

  @@map("Alerts")
}

model Retail {
  id          Int     @id @default(autoincrement())
  name        String
  address     String
  longitude   Float?
  latitude    Float?
  phoneNumber String? @map("phone_number")
  websiteUrl  String? @map("website_url") @db.Text

  @@map("Retails")
}

model TireData {
  id            Int        @id @default(autoincrement())
  model         String
  terrainTypes  String[]
  minPressure   Float
  maxPressure   Float
  maxKilometers Int
  userTires     UserTire[]

  @@map("tire_data")
}

model ActivityTire {
  tireId     Int      @map("tire_id")
  activityId Int      @map("activities_id")
  tire       UserTire @relation(fields: [tireId], references: [id])
  activity   Activity @relation(fields: [activityId], references: [id])

  @@id([tireId, activityId])
  @@map("activites_has_tires")
}

enum Roles {
  USER
  ADMIN
}

enum ActivitySource {
  STRAVA
  APP_TRACKED
}

enum ActivityStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TerrainType {
  ROAD
  TRAIL
  GRAVEL
  MIXED
  UNKNOWN
}
