// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  mail          String         @unique()
  password      String?
  stravaAccount StravaAccount?
  oauthStates   OAuthState[]
  tires         UserTire[]
  roles         Roles[]        @default([USER])
  activities    Activity[]

  accountType  AccountType @default(STANDARD) @map("account_type")
  points       Int         @default(0)
  currentTier  String      @default("BRONZE") @map("current_tier")
  referralCode String?     @unique @map("referral_code")

  referralsMade      Referral[]          @relation("Referrer")
  referralReceived   Referral?           @relation("Referred")
  pointsTransactions PointsTransaction[]
  rewards            Reward[]

  @@map("Users")
}

model StravaAccount {
  id String @id @default(uuid())

  userId    Int @unique
  athleteId Int @unique

  username  String?
  firstname String?
  lastname  String?
  profile   String?

  accessToken  String
  refreshToken String
  expiresAt    Int

  scope String?

  lastSyncAt DateTime? @map("last_sync_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model OAuthState {
  id String @id @default(uuid())

  provider String
  userId   Int

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserTire {
  id            Int            @id @default(autoincrement())
  position      String?
  tireId        Int?           @map("tire_id")
  userId        Int?           @map("user_id")
  kilometers    Int?
  smartTire     Boolean?       @map("smart_tire")
  isActive      Boolean?       @map("isActive")
  tire          TireData?      @relation(fields: [tireId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  activityTires ActivityTire[]
  alerts        Alert[]

  @@map("users_tire")
}

model Activity {
  id               Int                @id @default(autoincrement())
  userId           Int                @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stravaActivityId BigInt?            @map("strava_activity_id")
  name             String?
  source           ActivitySource
  status           ActivityStatus     @default(COMPLETED)
  startPosition    Int?               @map("start_position")
  kilometers       Float?
  durationSeconds  Int?               @map("duration_seconds")
  terrainType      TerrainType        @default(UNKNOWN) @map("terrain_type")
  startedAt        DateTime?          @map("started_at")
  endedAt          DateTime?          @map("ended_at")
  date             DateTime?          @db.Date
  rewardedKilometers Float            @default(0) @map("rewarded_kilometers")
  tires            ActivityTire[]
  gpsPoints        ActivityGpsPoint[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, stravaActivityId])
  @@index([userId])
  @@map("Activities")
}

model ActivityGpsPoint {
  id Int @id @default(autoincrement())

  activityId Int @map("activity_id")

  latitude   Float
  longitude  Float
  accuracy   Float?
  altitude   Float?
  speed      Float?
  recordedAt DateTime @map("recorded_at")

  createdAt DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("ActivityGpsPoints")
}

model Alert {
  id         Int     @id @default(autoincrement())
  userTireId Int     @map("user_tire_id")
  code       String
  isChecked  Boolean @default(false)
  message    String
  metadata   Json?

  userTire UserTire? @relation(fields: [userTireId], references: [id])

  @@map("Alerts")
}

model Retail {
  id          Int     @id @default(autoincrement())
  name        String
  address     String
  longitude   Float?
  latitude    Float?
  phoneNumber String? @map("phone_number")
  websiteUrl  String? @map("website_url") @db.Text

  @@map("Retails")
}

model TireData {
  id            Int           @id @default(autoincrement())
  model         String
  terrainTypes  TerrainType[]

  usageType     TireUsageType?
  wheelDiameter String?       @map("wheel_diameter")
  etrtoDiameter Int?          @map("etrto_diameter")
  etrtoWidth    Int?          @map("etrto_width")

  rimType       RimType?      @map("rim_type")
  sealingType   SealingType?  @map("sealing_type")
  fitting       TireFitting?  @map("fitting")

  eBikeCompatible Boolean @default(false) @map("e_bike_compatible")

  performanceProfiles TirePerformanceProfile[] @map("performance_profiles")

  familyName    String? @map("family_name")
  productRange  String? @map("product_range")

  recommendationWeight Int @default(0) @map("recommendation_weight")

  minPressure   Float
  maxPressure   Float
  maxKilometers Int
  userTires     UserTire[]

  @@map("tire_data")
}

enum TerrainType {
  ASPHALT
  HARD_PACKED
  MIXED
  GRAVEL
  ROCKY
  MUD
  SOFT
  SAND
  WET
  UNKNOWN
}

model ActivityTire {
  tireId     Int      @map("tire_id")
  activityId Int      @map("activities_id")
  tire       UserTire @relation(fields: [tireId], references: [id])
  activity   Activity @relation(fields: [activityId], references: [id])

  @@id([tireId, activityId])
  @@map("activites_has_tires")
}

model Referral {
  id          Int            @id @default(autoincrement())
  referrerId  Int            @map("referrer_id")
  referredId  Int            @unique @map("referred_id")
  status      ReferralStatus @default(REGISTERED)
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

model PointsTransaction {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  amount    Int
  source    PointsSource
  reference String       @unique
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("points_transactions")
}

model Reward {
  id              Int          @id @default(autoincrement())
  userId          Int          @map("user_id")
  type            RewardType
  code            String       @unique
  source          PointsSource
  status          RewardStatus @default(AVAILABLE)
  discountPercent Int?         @map("discount_percent")
  category        String?
  amount          Float?
  reference       String?
  expiresAt       DateTime?    @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rewards")
}

enum Roles {
  USER
  ADMIN
}

enum AccountType {
  STANDARD
  INFLUENCER
}

enum ReferralStatus {
  REGISTERED
  COMPLETED
}

enum PointsSource {
  REFERRAL
  KILOMETERS
  TIER
}

enum RewardType {
  DISCOUNT_VOUCHER
  COMMISSION
}

enum RewardStatus {
  AVAILABLE
  USED
  EXPIRED
  PAID
}

enum ActivitySource {
  STRAVA
  APP_TRACKED
}

enum ActivityStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TireUsageType {
  ROAD
  GRAVEL
  MTB
  CITY
  TOURING
  COMMUTING
  E_BIKE
}

enum RimType {
  CLINCHER
  TUBELESS
  TUBULAR
}

enum SealingType {
  TUBE
  TUBELESS_READY
  TUBELESS
}

enum TireFitting {
  FRONT
  REAR
  FRONT_REAR
}

enum TirePerformanceProfile {
  COMFORT
  SPEED
  GRIP
  DURABILITY
  PUNCTURE_PROTECTION
}
